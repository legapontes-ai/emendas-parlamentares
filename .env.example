# Copie para .env e preencha com valores reais. NÃO versione o .env.

# PostgreSQL (Neon) — pooled para runtime
DATABASE_URL=

# PostgreSQL (Neon) — conexão direta para migrations
DIRECT_URL=

# Auth.js — gere com: npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET=

# URL base da aplicação (ex.: http://localhost:3000 em dev)
AUTH_URL=
